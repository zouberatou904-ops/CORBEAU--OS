<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CORBEAU - Gagne avec ton tel</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.tailwindcss.com"></script>
<style>@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@700;900&display=swap');*{font-family:'Outfit',sans-serif}</style>
</head>
<body class="bg-[#f6f5f2]">
<div id="app"></div>
<script>
const SUPA_URL="https://nmkpanyeswafuchmvclj.supabase.co";
const SUPA_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ta3Bhbnllc3dhZnVjaG12Y2xqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAzNTcxNTIsImV4cCI6MjEwNTkzMzE1Mn0.fleM-nhlLGteYjbdmWIlkzsgQS-zs3cf38-hTVBiKm8";
const supabase=window.supabase.createClient(SUPA_URL,SUPA_KEY);
let currentUser=JSON.parse(localStorage.getItem('corbeau_user')||'null');
let products=[];

async function init(){
  let {data}=await supabase.from('corbeau_products').select('*').order('created_at',{ascending:false});
  products=data||[];
  render();
}

function render(){
  let app=document.getElementById('app');
  if(!currentUser){
    app.innerHTML=`
    <div class="min-h-screen bg-black text-white flex flex-col items-center justify-center p-6">
      <div class="text-6xl">🦅</div><h1 class="text-4xl font-black mt-2">CORBEAU</h1>
      <p class="opacity-60 mb-8">Gagne avec ton téléphone</p>
      <div class="bg-white text-black w-full max-w-sm rounded-[24px] p-6 space-y-3">
        <h2 class="font-black text-xl">Devenir Vendeur</h2>
        <input id="nom" placeholder="Ton nom" class="w-full p-4 bg-gray-100 rounded-xl">
        <input id="wa" placeholder="WhatsApp 229..." class="w-full p-4 bg-gray-100 rounded-xl">
        <input id="ville" placeholder="Ville (Abomey-Calavi)" class="w-full p-4 bg-gray-100 rounded-xl">
        <button onclick="inscrire()" class="w-full bg-black text-white p-4 rounded-xl font-black">Devenir Vendeur →</button>
        <button onclick="loginRapide()" class="w-full text-xs opacity-50 underline">Déjà vendeur? Connexion</button>
        <p id="msg" class="text-center text-sm"></p>
      </div>
    </div>`;
    return;
  }
  app.innerHTML=`
  <div class="max-w-[480px] mx-auto min-h-screen bg-white pb-10">
    <div class="bg-black text-white p-6 rounded-b-[32px]">
      <div class="flex justify-between">
        <div><p class="text-xs opacity-60">Solde</p><h1 class="text-3xl font-black">${currentUser.solde||0} FCFA</h1></div>
        <div class="text-right"><p class="font-bold">${currentUser.nom}</p><p class="text-xs opacity-60">${currentUser.code_vendeur}</p></div>
      </div>
      <button onclick="partagerLien()" class="w-full mt-6 bg-white text-black p-3 rounded-xl font-black">Partager mon lien 📤</button>
    </div>
    <div class="p-4">
      <h2 class="font-black text-xl mb-3">Produits à vendre</h2>
      ${products.map(p=>`
        <div class="border rounded-[20px] overflow-hidden mb-4">
          <img src="${p.image}" class="h-48 w-full object-cover">
          <div class="p-4">
            <h3 class="font-bold">${p.nom}</h3>
            <p class="text-sm opacity-60">Prix: ${p.prix}F | <b class="text-green-600">${p.commission}F</b> pour toi</p>
            <div class="grid grid-cols-2 gap-2 mt-3">
              <button onclick="commander('${p.id}')" class="bg-black text-white p-3 rounded-xl font-bold text-sm">Commander client</button>
              <button onclick="partagerProduit('${p.id}')" class="bg-gray-100 p-3 rounded-xl font-bold text-sm">Partager WA</button>
            </div>
          </div>
        </div>`).join('')}
      <button onclick="logout()" class="w-full text-xs opacity-30 mt-6">Déconnexion</button>
    </div>
  </div>
  <div id="modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center p-6 z-50"><div id="box" class="bg-white rounded-[24px] p-6 w-full max-w-sm"></div></div>`;
}

async function inscrire(){
  let nom=document.getElementById('nom').value.trim();
  let wa=document.getElementById('wa').value.trim();
  let ville=document.getElementById('ville').value.trim();
  if(!nom||!wa||!ville) return alert('Remplis tout');
  document.getElementById('msg').innerText='Envoi...';
  let code='CB'+Math.random().toString(36).substring(2,6).toUpperCase();
  await supabase.from('corbeau_pending').insert({nom,whatsapp:wa,ville});
  await supabase.from('corbeau_notifs').insert({type:'nouveau_vendeur',message:nom+' veut devenir vendeur ('+ville+')'});
  let {data,error}=await supabase.from('corbeau_users').insert({nom,whatsapp:wa,ville,code_vendeur:code,solde:0}).select().single();
  if(error){document.getElementById('msg').innerText='Numéro déjà utilisé → Clique Connexion';return;}
  localStorage.setItem('corbeau_user',JSON.stringify(data));
  currentUser=data; render();
}
function loginRapide(){
  let wa=prompt('Ton WhatsApp:'); if(!wa) return;
  supabase.from('corbeau_users').select('*').eq('whatsapp',wa).single().then(r=>{
    if(r.error||!r.data) return alert('Pas trouvé, inscris-toi');
    localStorage.setItem('corbeau_user',JSON.stringify(r.data)); currentUser=r.data; render();
  });
}
function partagerLien(){
  let t=`🦅 CORBEAU - Commande avec mon lien vendeur ${currentUser.nom} - Code: ${currentUser.code_vendeur}`;
  window.open('https://wa.me/?text='+encodeURIComponent(t));
}
function partagerProduit(id){
  let p=products.find(x=>x.id===id);
  let t=`🦅 ${p.nom} à ${p.prix}FCFA! Commission ${p.commission}F pour toi avec mon code ${currentUser.code_vendeur} - Dis ton nom et quartier`;
  window.open('https://wa.me/?text='+encodeURIComponent(t));
}
function commander(id){
  let p=products.find(x=>x.id===id);
  let box=document.getElementById('box'); let m=document.getElementById('modal');
  box.innerHTML=`
    <h3 class="font-black text-xl">Commande: ${p.nom}</h3>
    <input id="c_nom" placeholder="Nom client" class="w-full mt-4 p-3 bg-gray-100 rounded-xl">
    <input id="c_wa" placeholder="WhatsApp client" class="w-full mt-3 p-3 bg-gray-100 rounded-xl">
    <input id="c_ville" placeholder="Ville/Quartier" class="w-full mt-3 p-3 bg-gray-100 rounded-xl">
    <button onclick="valider('${id}')" class="w-full mt-4 bg-black text-white p-3 rounded-xl font-black">Valider commande</button>
    <button onclick="document.getElementById('modal').classList.add('hidden')" class="w-full mt-2 text-xs opacity-50">Annuler</button>`;
  m.classList.remove('hidden'); m.classList.add('flex');
}
async function valider(pid){
  let p=products.find(x=>x.id===pid);
  let cn=document.getElementById('c_nom').value; let cw=document.getElementById('c_wa').value; let cv=document.getElementById('c_ville').value;
  if(!cn||!cw) return alert('Remplis');
  await supabase.from('corbeau_orders').insert({client_nom:cn,client_whatsapp:cw,client_ville:cv,produit_id:p.id,produit_nom:p.nom,prix:p.prix,commission:p.commission,vendeur_code:currentUser.code_vendeur,vendeur_nom:currentUser.nom,statut:'nouvelle'});
  await supabase.from('corbeau_notifs').insert({type:'commande',message:currentUser.nom+' a une commande de '+p.nom+' pour '+cn});
  document.getElementById('modal').classList.add('hidden'); alert('Commande envoyée au Boss!');
}
function logout(){localStorage.removeItem('corbeau_user'); location.reload();}
init();
</script>
</body>
</html>
